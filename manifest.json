{
  "manifest_version": 3,
  "name": "Kinopoisk Switcher",
  "version": "1.2",
  "description": "Быстрое переключение Кинопоиска и быстрый доступ к фильмам и сериалам.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.kinopoisk.ru/*",
    "https://www.kinopoisk.vip/*"
  ]
}